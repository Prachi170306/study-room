
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Focus sessions
    match /focusSessions/{sessionId} {
      allow read, write: if request.auth != null;
    }

    // User profiles
    match /users/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;

      // Tasks
      match /tasks/{taskId} {
        allow read, write: if request.auth != null
                           && request.auth.uid == userId;
      }

      // Dashboard
      match /dashboard/{documentId} {
        allow read, write: if request.auth != null
                           && request.auth.uid == userId;
      }

      // Personal Resource Bookmarks
      match /bookmarks/{resourceId} {
        allow read, create, delete: if request.auth != null
                                    && request.auth.uid == userId;
        allow update: if false;
      }

      // Notifications
      match /notifications/{notificationId} {
        allow read: if request.auth != null
                    && request.auth.uid == userId;

        allow update: if request.auth != null
                      && request.auth.uid == userId
                      && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['read'])
                      && request.resource.data.read is bool;

        allow create, delete: if false;
      }
    }

    // Public Chat profiles
    match /chatProfiles/{userId} {
      allow read: if request.auth != null;

      allow create, update, delete: if request.auth != null
                                    && request.auth.uid == userId;
    }

    // Chat conversations
    match /chats/{chatId} {

      // Allow checking whether a chat ID exists.
      // Existing conversations remain private to their members.
      allow get: if request.auth != null
                 && (
                   !exists(/databases/$(database)/documents/chats/$(chatId))
                   || request.auth.uid in resource.data.members
                 );

      // Only members can list conversations.
      allow list: if request.auth != null
                  && request.auth.uid in resource.data.members;

      // Create personal or group conversations.
      allow create: if request.auth != null
                    && request.auth.uid in request.resource.data.members
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.members is list
                    && request.resource.data.members.size() >= 2
                    && request.resource.data.type in ['personal', 'group']
                    && request.resource.data.memberInfo is map;

      // Update latest message information.
      allow update: if request.auth != null
                    && request.auth.uid in resource.data.members
                    && request.resource.data.members == resource.data.members
                    && request.resource.data.createdBy == resource.data.createdBy
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['lastMessage', 'updatedAt'])
                    && request.resource.data.lastMessage is map
                    && request.resource.data.lastMessage.senderId == request.auth.uid
                    && request.resource.data.lastMessage.text is string
                    && request.resource.data.lastMessage.text.size() > 0
                    && request.resource.data.lastMessage.text.size() <= 5000;

      // Prevent conversation deletion.
      allow delete: if false;

      // Messages inside conversations.
      match /messages/{messageId} {

        // Only conversation members can read messages.
        allow read: if request.auth != null
                    && request.auth.uid in
                    get(/databases/$(database)/documents/chats/$(chatId))
                    .data.members;

        // Only conversation members can send messages as themselves.
        allow create: if request.auth != null
                      && request.auth.uid in
                      get(/databases/$(database)/documents/chats/$(chatId))
                      .data.members
                      && request.resource.data.senderId == request.auth.uid
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 5000;

        // Prevent editing or deleting messages.
        allow update, delete: if false;
      }
    }

    // StudySphere Resource Library
    match /resources/{resourceId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.title is string
                    && request.resource.data.title.size() > 0
                    && request.resource.data.title.size() <= 200
                    && request.resource.data.description is string
                    && request.resource.data.filePath is string
                    && request.resource.data.filePath.matches(
                         'resources/' + request.auth.uid + '/.*'
                       )
                    && request.resource.data.fileType in [
                         'application/pdf',
                         'image/jpeg',
                         'image/png',
                         'image/webp'
                       ]
                    && request.resource.data.createdAt is timestamp;

      allow update: if false;

      allow delete: if request.auth != null
                    && resource.data.ownerId == request.auth.uid;
    }


    // Doubt Corner
    match /doubts/{questionId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.title is string
                    && request.resource.data.title.size() > 0
                    && request.resource.data.title.size() <= 200
                    && request.resource.data.description is string
                    && request.resource.data.description.size() > 0
                    && request.resource.data.description.size() <= 10000
                    && request.resource.data.author is string
                    && request.resource.data.answers is list
                    && request.resource.data.answers.size() == 0
                    && request.resource.data.acceptedAnswerId == null
                    && request.resource.data.createdAt is timestamp;

      // Question owner can moderate answers and accepted-answer status.
      // Other signed-in users can only append an answer authored by themselves.
      allow update: if request.auth != null
                    && request.resource.data.diff(resource.data)
                       .affectedKeys().hasOnly(['answers', 'acceptedAnswerId'])
                    && (
                      resource.data.ownerId == request.auth.uid
                      ||
                      (
                        request.resource.data.diff(resource.data)
                          .affectedKeys().hasOnly(['answers'])
                        && request.resource.data.answers is list
                        && request.resource.data.answers.size()
                           == resource.data.answers.size() + 1
                        && request.resource.data.answers.hasAll(resource.data.answers)
                        && request.resource.data.answers[
                             resource.data.answers.size()
                           ] is map
                        && request.resource.data.answers[
                             resource.data.answers.size()
                           ].authorId == request.auth.uid
                      )
                    );

      allow delete: if request.auth != null
                    && resource.data.ownerId == request.auth.uid;
    }

    // Study Rooms
    match /studyRooms/{roomId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.roomName is string
                    && request.resource.data.members is list
                    && request.resource.data.members.size() == 1
                    && request.resource.data.members[0] == request.auth.uid
                    && request.resource.data.isActive == true
                    && request.resource.data.createdAt is timestamp;

      allow update: if request.auth != null
                    && (
                      (
                        resource.data.createdBy == request.auth.uid
                        && request.resource.data.diff(resource.data)
                           .affectedKeys().hasOnly(['timer'])
                      )
                      ||
                      (
                        request.resource.data.diff(resource.data)
                           .affectedKeys().hasOnly(['members'])
                        && request.resource.data.members is list
                        && request.resource.data.members.size()
                           == resource.data.members.size() + 1
                        && request.resource.data.members.hasAll(resource.data.members)
                        && request.auth.uid in request.resource.data.members
                        && !(request.auth.uid in resource.data.members)
                      )
                    );

      allow delete: if false;

      match /studySessions/{sessionId} {
        allow get: if request.auth != null
                   && (
                     !exists(/databases/$(database)/documents/studyRooms/$(roomId)/studySessions/$(sessionId))
                     || request.auth.uid in resource.data.participantIds
                   );

        allow list: if request.auth != null
                    && request.auth.uid in resource.data.participantIds;

        allow create: if request.auth != null
                      && request.resource.data.completedBy == request.auth.uid
                      && request.resource.data.participantIds is list
                      && request.auth.uid in request.resource.data.participantIds;

        allow update, delete: if false;
      }
    }

    // Collection-group access for a user's study sessions.
    match /{path=**}/studySessions/{sessionId} {
      allow read: if request.auth != null
                  && request.auth.uid in resource.data.participantIds;
    }

  }
}
