
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Focus sessions
    match /focusSessions/{sessionId} {
      allow read, write: if request.auth != null;
    }

    // User profiles
    match /users/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;

      // Tasks
      match /tasks/{taskId} {
        allow read, write: if request.auth != null
                           && request.auth.uid == userId;
      }

      // Dashboard
      match /dashboard/{documentId} {
        allow read, write: if request.auth != null
                           && request.auth.uid == userId;
      }
    }

    // Public Chat profiles
    match /chatProfiles/{userId} {
      allow read: if request.auth != null;

      allow create, update, delete: if request.auth != null
                                    && request.auth.uid == userId;
    }

    // Chat conversations
    match /chats/{chatId} {

      // Allow checking whether a chat ID exists.
      // Existing conversations remain private to their members.
      allow get: if request.auth != null
                 && (
                   !exists(/databases/$(database)/documents/chats/$(chatId))
                   || request.auth.uid in resource.data.members
                 );

      // Only members can list conversations.
      allow list: if request.auth != null
                  && request.auth.uid in resource.data.members;

      // Create personal or group conversations.
      allow create: if request.auth != null
                    && request.auth.uid in request.resource.data.members
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.members is list
                    && request.resource.data.members.size() >= 2
                    && request.resource.data.type in ['personal', 'group']
                    && request.resource.data.memberInfo is map;

      // Update latest message information.
      allow update: if request.auth != null
                    && request.auth.uid in resource.data.members
                    && request.resource.data.members == resource.data.members
                    && request.resource.data.createdBy == resource.data.createdBy
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['lastMessage', 'updatedAt'])
                    && request.resource.data.lastMessage is map
                    && request.resource.data.lastMessage.senderId == request.auth.uid
                    && request.resource.data.lastMessage.text is string
                    && request.resource.data.lastMessage.text.size() > 0
                    && request.resource.data.lastMessage.text.size() <= 5000;

      // Prevent conversation deletion.
      allow delete: if false;

      // Messages inside conversations.
      match /messages/{messageId} {

        // Only conversation members can read messages.
        allow read: if request.auth != null
                    && request.auth.uid in
                    get(/databases/$(database)/documents/chats/$(chatId))
                    .data.members;

        // Only conversation members can send messages as themselves.
        allow create: if request.auth != null
                      && request.auth.uid in
                      get(/databases/$(database)/documents/chats/$(chatId))
                      .data.members
                      && request.resource.data.senderId == request.auth.uid
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 5000;

        // Prevent editing or deleting messages.
        allow update, delete: if false;
      }
    }
  }
}
